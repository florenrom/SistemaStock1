@model NuevoSistemaNat.Models.ViewModels.ProveedorViewModel

@{
    ViewData["Title"] = "Nuevo proveedor";
}

<div class="sf-crud">

    <h1>Nuevo proveedor</h1>

    <p class="sf-crud-description">
        Registrá un nuevo proveedor para administrar sus datos de contacto.
    </p>

    <div class="sf-crud-card">

        <h5 class="sf-crud-card-title">
            <i class="bi bi-truck me-2"></i>
            Información del proveedor
        </h5>

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre"
                           class="form-control"
                           placeholder="Nombre del proveedor" />
                    <span asp-validation-for="Nombre"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Documento" class="form-label"></label>
                    <input asp-for="Documento"
                           class="form-control"
                           placeholder="Número de documento" />
                    <span asp-validation-for="Documento"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Direccion" class="form-label"></label>
                    <input asp-for="Direccion"
                           class="form-control"
                           placeholder="Dirección del proveedor" />
                    <span asp-validation-for="Direccion"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Telefono" class="form-label"></label>
                    <input asp-for="Telefono"
                           class="form-control"
                           placeholder="Número de teléfono" />
                    <span asp-validation-for="Telefono"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Correo electrónico" />
                    <span asp-validation-for="Email"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3 d-flex align-items-center">
                    <div class="form-check mt-4">
                        <input asp-for="Activo"
                               class="form-check-input" />
                        <label asp-for="Activo"
                               class="form-check-label"></label>
                    </div>
                </div>

            </div>

            <div class="sf-crud-actions mt-3">

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save me-1"></i>
                    Guardar proveedor
                </button>

                <a asp-action="Index"
                   class="btn btn-link text-decoration-none">
                    Cancelar
                </a>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}