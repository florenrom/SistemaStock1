@model NuevoSistemaNat.Models.ViewModels.ProveedorViewModel

@{
    ViewData["Title"] = "Desactivar proveedor";
}

<div class="sf-crud">

    <h1>Desactivar proveedor</h1>

    <p class="sf-crud-description">
        Revisá los datos antes de confirmar la desactivación.
    </p>

    <div class="sf-crud-card">

        <h5 class="sf-crud-card-title">
            <i class="bi bi-truck me-2"></i>
            Información del proveedor
        </h5>

        <div class="sf-crud-warning mb-4">
            <i class="bi bi-exclamation-triangle me-2"></i>
            ¿Estás seguro de que deseas desactivar este proveedor?
            El registro se conservará en el sistema.
        </div>

        <dl class="row sf-crud-details">

            <dt class="col-md-4">
                @Html.DisplayNameFor(model => model.Nombre)
            </dt>
            <dd class="col-md-8">
                @Html.DisplayFor(model => model.Nombre)
            </dd>

            <dt class="col-md-4">
                @Html.DisplayNameFor(model => model.Documento)
            </dt>
            <dd class="col-md-8">
                @(Model.Documento ?? "-")
            </dd>

            <dt class="col-md-4">
                @Html.DisplayNameFor(model => model.Direccion)
            </dt>
            <dd class="col-md-8">
                @(Model.Direccion ?? "-")
            </dd>

            <dt class="col-md-4">
                @Html.DisplayNameFor(model => model.Telefono)
            </dt>
            <dd class="col-md-8">
                @(Model.Telefono ?? "-")
            </dd>

            <dt class="col-md-4">
                @Html.DisplayNameFor(model => model.Email)
            </dt>
            <dd class="col-md-8">
                @(Model.Email ?? "-")
            </dd>

        </dl>

        <form asp-action="Delete" method="post">

            <input type="hidden" asp-for="id" />

            <div class="sf-crud-actions mt-3">

                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-person-x me-1"></i>
                    Confirmar desactivación
                </button>

                <a asp-action="Index"
                   class="btn btn-link text-decoration-none">
                    Cancelar
                </a>

            </div>

        </form>

    </div>
</div>