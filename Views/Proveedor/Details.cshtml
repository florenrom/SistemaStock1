@model NuevoSistemaNat.Models.ViewModels.ProveedorViewModel

@{
    ViewData["Title"] = "Detalles del proveedor";
}

<div class="sf-crud">

    <h1>Detalles del proveedor</h1>

    <p class="sf-crud-description">
        Consultá la información del proveedor seleccionado.
    </p>

    <div class="sf-crud-card">

        <h5 class="sf-crud-card-title">
            <i class="bi bi-truck me-2"></i>
            Información del proveedor
        </h5>

        <dl class="row sf-crud-details">

            <dt class="col-md-4">
                @Html.DisplayNameFor(model => model.Nombre)
            </dt>
            <dd class="col-md-8">
                @Html.DisplayFor(model => model.Nombre)
            </dd>

            <dt class="col-md-4">
                @Html.DisplayNameFor(model => model.Documento)
            </dt>
            <dd class="col-md-8">
                @(Model.Documento ?? "-")
            </dd>

            <dt class="col-md-4">
                @Html.DisplayNameFor(model => model.Direccion)
            </dt>
            <dd class="col-md-8">
                @(Model.Direccion ?? "-")
            </dd>

            <dt class="col-md-4">
                @Html.DisplayNameFor(model => model.Telefono)
            </dt>
            <dd class="col-md-8">
                @(Model.Telefono ?? "-")
            </dd>

            <dt class="col-md-4">
                @Html.DisplayNameFor(model => model.Email)
            </dt>
            <dd class="col-md-8">
                @(Model.Email ?? "-")
            </dd>

            <dt class="col-md-4">
                @Html.DisplayNameFor(model => model.Activo)
            </dt>
            <dd class="col-md-8">
                @if (Model.Activo)
                {
                    <span class="badge bg-success">Activo</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactivo</span>
                }
            </dd>

        </dl>

        <div class="sf-crud-actions mt-3">

            <a asp-action="Edit"
               asp-route-id="@Model.id"
               class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i>
                Editar proveedor
            </a>

            <a asp-action="Index"
               class="btn btn-link text-decoration-none">
                Volver al listado
            </a>

        </div>

    </div>
</div>