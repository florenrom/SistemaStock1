@model NuevoSistemaNat.Models.ViewModels.DashboardViewModel
@using NuevoSistemaNat.Models.Enum

@{
    ViewData["Title"] = "Panel de Control";
    ViewData["SubTitle"] = "Dashboard";
}

@* <td>@movimiento.Tipo</td> *@

<div class="container-fluid">

    <!-- Título -->
    <div class="mb-4">
        <h2>Panel de Control</h2>
        <p class="text-muted">
            Resumen general del estado del inventario.
        </p>
    </div>

    <!-- ================= KPIs ================= -->

    <div class="row g-3 mb-4">

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Productos activos</h6>
                    <h3>@Model.TotalProductosActivos</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Proveedores activos</h6>
                    <h3>@Model.TotalProveedoresActivos</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Clientes activos</h6>
                    <h3>@Model.TotalClientesActivos</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Depósitos activos</h6>
                    <h3>@Model.TotalDepositosActivos</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Valor total del inventario</h6>
                    <h3>@Model.ValorTotalInventario.ToString("C2")</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Valor estimado de ventas de hoy</h6>
                    <h3>@Model.ValorVentasHoy.ToString("C2")</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Movimientos de hoy</h6>
                    <h3>@Model.MovimientosHoy</h3>
                </div>
            </div>
        </div>

    </div>

    <!-- ================= ALERTAS ================= -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">Alertas de reposición</h5>
        </div>

        <div class="card-body">

            @if (Model.AlertasReposicion.Any())
            {
                <div class="table-responsive">

                    <table class="table table-striped table-hover">

                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th>Categoría</th>
                                <th>Stock actual</th>
                                <th>Stock mínimo</th>
                                <th>Estado</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var a in Model.AlertasReposicion)
                            {
                                <tr>
                                    <td>@a.Producto</td>
                                    <td>@a.Categoria</td>
                                    <td>@a.StockTotal</td>
                                    <td>@a.StockMinimo</td>
                                    <td>
                                        @if (a.SinStock)
                                        {
                                            <span class="badge bg-danger">
                                                @a.Estado
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @a.Estado
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="alert alert-success mb-0">
                    No hay alertas de reposición.
                </div>
            }

        </div>
    </div>

    <!-- ================= STOCK POR DEPÓSITO ================= -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">Stock por depósito</h5>
        </div>

        <div class="card-body">

            @if (Model.StockPorDeposito.Any())
            {
                <div class="table-responsive">

                    <table class="table table-striped">

                        <thead>
                            <tr>
                                <th>Depósito</th>
                                <th>Total de unidades</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var deposito in Model.StockPorDeposito)
                            {
                                <tr>
                                    <td>@deposito.NombreDeposito</td>
                                    <td>@deposito.TotalUnidades</td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    No hay depósitos con información disponible.
                </p>
            }

        </div>
    </div>

    <!-- ================= ÚLTIMOS MOVIMIENTOS ================= -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">Últimos movimientos</h5>
        </div>

        <div class="card-body">

            @if (Model.UltimosMovimientos.Any())
            {
                <div class="table-responsive">

                    <table class="table table-striped table-hover">

                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th>Tipo</th>
                                <th>Cantidad</th>
                                <th>Depósito</th>
                                <th>Fecha</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var movimiento in Model.UltimosMovimientos)
                            {
                                <tr>
                                    <td>@movimiento.Producto</td>
                                    <td>
                                        @if (movimiento.Tipo == TipoMovimiento.TransferenciaEntrada || movimiento.Tipo == TipoMovimiento.TransferenciaSalida)
                                        {
                                            <span class="badge bg-info text-dark">Transferencia</span>
                                        }
                                        else if (movimiento.Tipo == TipoMovimiento.Entrada)
                                        {
                                            <span class="badge bg-success">Entrada</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Salida</span>
                                        }
                                    </td>
                                    <td>@movimiento.Cantidad</td>
                                    <td>@movimiento.Deposito</td>
                                    <td>@movimiento.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    Todavía no hay movimientos registrados.
                </p>
            }

        </div>
    </div>

</div>