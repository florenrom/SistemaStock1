@model NuevoSistemaNat.Models.ViewModels.DashboardViewModel
@using NuevoSistemaNat.Models.Enum

@{
    ViewData["Title"] = "Panel de control";
}

<div class="container-fluid">

    <!-- BIENVENIDA -->
    <div class="sf-welcome">
        <h2>¡Bienvenido a StockFlow!</h2>
        <p>Este es el resumen general de tu sistema de gestión de stock.</p>
    </div>

    <!-- INDICADORES GENERALES -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="sf-kpi">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="sf-kpi-label">Productos activos</p>
                        <h3 class="sf-kpi-value">@Model.TotalProductosActivos</h3>
                    </div>
                    <div class="sf-kpi-icon sf-icon-green">
                        <i class="bi bi-box-seam"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="sf-kpi">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="sf-kpi-label">Proveedores activos</p>
                        <h3 class="sf-kpi-value">@Model.TotalProveedoresActivos</h3>
                    </div>
                    <div class="sf-kpi-icon sf-icon-brown">
                        <i class="bi bi-truck"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="sf-kpi">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="sf-kpi-label">Clientes activos</p>
                        <h3 class="sf-kpi-value">@Model.TotalClientesActivos</h3>
                    </div>
                    <div class="sf-kpi-icon sf-icon-violet">
                        <i class="bi bi-people"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="sf-kpi">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="sf-kpi-label">Depósitos activos</p>
                        <h3 class="sf-kpi-value">@Model.TotalDepositosActivos</h3>
                    </div>
                    <div class="sf-kpi-icon sf-icon-yellow">
                        <i class="bi bi-building"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- INDICADORES DE STOCK Y MOVIMIENTOS -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-md-4">
            <div class="sf-kpi">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="sf-kpi-label">Valor total del inventario</p>
                        <h3 class="sf-kpi-value">@Model.ValorTotalInventario.ToString("C2")</h3>
                    </div>
                    <div class="sf-kpi-icon sf-icon-green">
                        <i class="bi bi-currency-dollar"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="sf-kpi">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="sf-kpi-label">Valor estimado de salidas de hoy</p>
                        <h3 class="sf-kpi-value">@Model.ValorVentasHoy.ToString("C2")</h3>
                    </div>
                    <div class="sf-kpi-icon sf-icon-violet">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="sf-kpi">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="sf-kpi-label">Movimientos de hoy</p>
                        <h3 class="sf-kpi-value">@Model.MovimientosHoy</h3>
                    </div>
                    <div class="sf-kpi-icon sf-icon-brown">
                        <i class="bi bi-arrow-left-right"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- ACCIONES RÁPIDAS -->
    <div class="sf-panel mb-4">
        <h5 class="sf-panel-title">Acciones rápidas</h5>

        <div class="row g-3">

            <div class="col-12 col-sm-6 col-lg-4">
                <a asp-controller="Productos" asp-action="Create" class="sf-action">
                    <span class="sf-action-icon">
                        <i class="bi bi-plus-circle"></i>
                    </span>
                    <span>Registrar producto</span>
                </a>
            </div>

            <div class="col-12 col-sm-6 col-lg-4">
                <a asp-controller="Movimiento" asp-action="Entrada" class="sf-action">
                    <span class="sf-action-icon">
                        <i class="bi bi-box-arrow-in-down"></i>
                    </span>
                    <span>Registrar entrada</span>
                </a>
            </div>

            <div class="col-12 col-sm-6 col-lg-4">
                <a asp-controller="Movimiento" asp-action="Salida" class="sf-action">
                    <span class="sf-action-icon">
                        <i class="bi bi-box-arrow-up"></i>
                    </span>
                    <span>Registrar salida</span>
                </a>
            </div>

            <div class="col-12 col-sm-6 col-lg-4">
                <a asp-controller="Movimiento" asp-action="Transferencia" class="sf-action">
                    <span class="sf-action-icon">
                        <i class="bi bi-arrow-left-right"></i>
                    </span>
                    <span>Transferir stock</span>
                </a>
            </div>

            <div class="col-12 col-sm-6 col-lg-4">
                <a asp-controller="Movimiento" asp-action="Index" class="sf-action">
                    <span class="sf-action-icon">
                        <i class="bi bi-clock-history"></i>
                    </span>
                    <span>Ver movimientos</span>
                </a>
            </div>

            <div class="col-12 col-sm-6 col-lg-4">
                <a asp-controller="Categoria" asp-action="Index" class="sf-action">
                    <span class="sf-action-icon">
                        <i class="bi bi-tags"></i>
                    </span>
                    <span>Ver categorías</span>
                </a>
            </div>

        </div>
    </div>

    <!-- GRÁFICO DE MOVIMIENTOS -->
    <div class="sf-panel mb-4">

        <h5 class="sf-panel-title">
            <i class="bi bi-bar-chart-line me-2"></i>
            Movimientos de los últimos 7 días
        </h5>

        <div style="position: relative; height: 320px;">
            <canvas id="graficoMovimientos"></canvas>
        </div>

    </div>

    <!-- GRÁFICO DE PRODUCTOS CON MAYOR STOCK -->
    <div class="sf-panel mb-4">

        <h5 class="sf-panel-title">
            <i class="bi bi-box-seam me-2"></i>
            Productos con mayor stock
        </h5>

        <div style="position: relative; height: 320px;">
            <canvas id="graficoMayorStock"></canvas>
        </div>

    </div>

    <!-- GRÁFICO DE PRODUCTOS CON MENOR STOCK -->
    <div class="sf-panel mb-4">

        <h5 class="sf-panel-title">
            <i class="bi bi-exclamation-circle me-2"></i>
            Productos con menor stock
        </h5>

        <div style="position: relative; height: 320px;">
            <canvas id="graficoMenorStock"></canvas>
        </div>

    </div>

    <!-- GRÁFICO DE STOCK POR DEPÓSITO -->
    <div class="sf-panel mb-4">

        <h5 class="sf-panel-title">
            <i class="bi bi-pie-chart me-2"></i>
            Distribución del stock por depósito
        </h5>

        <div style="position: relative; height: 350px;">
            <canvas id="graficoStockDepositos"></canvas>
        </div>

    </div>

    <!-- ALERTAS Y STOCK POR DEPÓSITO -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-lg-7">
            <div class="sf-panel">
                <h5 class="sf-panel-title">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Alertas de reposición
                </h5>

                @if (Model.AlertasReposicion.Any())
                {
                    <div class="table-responsive">
                        <table class="table sf-table">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th>Categoría</th>
                                    <th>Stock actual</th>
                                    <th>Stock mínimo</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var alerta in Model.AlertasReposicion)
                                {
                                    <tr>
                                        <td>@alerta.Producto</td>
                                        <td>@alerta.Categoria</td>
                                        <td>@alerta.StockTotal</td>
                                        <td>@alerta.StockMinimo</td>
                                        <td>
                                            @if (alerta.SinStock)
                                            {
                                                <span class="sf-badge-danger">Sin stock</span>
                                            }
                                            else
                                            {
                                                <span class="sf-badge-warning">Bajo stock</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">
                        <i class="bi bi-check-circle me-2"></i>
                        No hay productos con alertas de reposición.
                    </p>
                }
            </div>
        </div>

        <div class="col-12 col-lg-5">
            <div class="sf-panel">
                <h5 class="sf-panel-title">
                    <i class="bi bi-building me-2"></i>
                    Stock por depósito
                </h5>

                @if (Model.StockPorDeposito.Any())
                {
                    <div class="table-responsive">
                        <table class="table sf-table">
                            <thead>
                                <tr>
                                    <th>Depósito</th>
                                    <th class="text-end">Unidades</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var deposito in Model.StockPorDeposito)
                                {
                                    <tr>
                                        <td>@deposito.NombreDeposito</td>
                                        <td class="text-end fw-bold">@deposito.TotalUnidades</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No hay información de stock por depósito.</p>
                }
            </div>
        </div>

    </div>

    <!-- ÚLTIMOS MOVIMIENTOS -->
    <div class="sf-panel mb-4">
        <h5 class="sf-panel-title">
            <i class="bi bi-clock-history me-2"></i>
            Últimos movimientos
        </h5>

        @if (Model.UltimosMovimientos.Any())
        {
            <div class="table-responsive">
                <table class="table sf-table">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Tipo</th>
                            <th>Cantidad</th>
                            <th>Depósito</th>
                            <th>Fecha</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var movimiento in Model.UltimosMovimientos)
                        {
                            <tr>
                                <td>@movimiento.Producto</td>
                                <td>
                                    @switch (movimiento.Tipo)
                                    {
                                        case TipoMovimiento.Entrada:
                                            <span class="sf-badge-success">Entrada</span>
                                            break;

                                        case TipoMovimiento.Salida:
                                            <span class="sf-badge-danger">Salida</span>
                                            break;

                                        case TipoMovimiento.TransferenciaEntrada:
                                        case TipoMovimiento.TransferenciaSalida:
                                            <span class="sf-badge-violet">Transferencia</span>
                                            break;
                                    }
                                </td>
                                <td>@movimiento.Cantidad</td>
                                <td>@movimiento.Deposito</td>
                                <td>@movimiento.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted mb-0">Todavía no hay movimientos registrados.</p>
        }
    </div>

</div>

@section Scripts {
    <script>

        const ctx = document.getElementById('graficoMovimientos');

        new Chart(ctx, {
            type: 'bar',

            data: {
                labels: ['Entradas', 'Salidas', 'Transferencias'],

                datasets: [{
                    label: 'Cantidad de movimientos',

                    data: [
                        @Model.EntradasUltimos7Dias,
                        @Model.SalidasUltimos7Dias,
                        @Model.TransferenciasUltimos7Dias
                    ],

                    backgroundColor: [
                        '#198754',
                        '#dc3545',
                        '#6f42c1'
                    ],

                    borderRadius: 8,
                    borderSkipped: false
                }]
            },

            options: {
                responsive: true,
                maintainAspectRatio: false,

                plugins: {
                    legend: {
                        display: false
                    }
                },

                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            precision: 0
                        }
                    }
                }
            }
        });

        const ctxStock = document.getElementById('graficoMayorStock');
            new Chart(ctxStock, {
                type: 'bar',

                data: {
                    labels: [
                        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                            Model.TopMayorStock.Select(p => p.Producto)
                                    ))
                ],

                datasets: [{
                    label: 'Unidades disponibles',

                    data: [
                        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                                    Model.TopMayorStock.Select(p => p.StockTotal)
                                            ))
                    ],

                    backgroundColor: '#198754',
                    borderRadius: 8,
                    borderSkipped: false
                }]
            },

            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,

                plugins: {
                    legend: {
                        display: false
                    }
                },

                scales: {
                    x: {
                        beginAtZero: true
                    }
                }
            }
         });

       // GRÁFICO DE PRODUCTOS CON MENOR STOCK
        const ctxMenorStock = document.getElementById('graficoMenorStock');

        new Chart(ctxMenorStock, {
            type: 'bar',

            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                    Model.TopMenorStock.Select(p => p.Producto)
                            )),

                datasets: [{
                    label: 'Unidades disponibles',

                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                            Model.TopMenorStock.Select(p => p.StockTotal)
                                    )),

                    backgroundColor: '#dc3545',
                    borderRadius: 8,
                    borderSkipped: false
                }]
            },

            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,

                plugins: {
                    legend: {
                        display: false
                    }
                },

                scales: {
                    x: {
                        beginAtZero: true,
                        ticks: {
                            precision: 0
                        }
                    }
                }
            }
        });

                // GRÁFICO DE STOCK POR DEPÓSITO
        const ctxDepositos = document.getElementById('graficoStockDepositos');

        new Chart(ctxDepositos, {
            type: 'doughnut',

            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                Model.StockPorDeposito.Select(d => d.NombreDeposito)
                        )),

            datasets: [{
                label: 'Unidades disponibles',

                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                        Model.StockPorDeposito.Select(d => d.TotalUnidades)
                                )),

                backgroundColor: [
                    '#198754',
                    '#6f42c1',
                    '#0d6efd',
                    '#ffc107',
                    '#dc3545',
                    '#20c997'
                ],

                    borderWidth: 2,
                    hoverOffset: 8
                }]
            },

            options: {
                responsive: true,
                maintainAspectRatio: false,

                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });


    </script>
}