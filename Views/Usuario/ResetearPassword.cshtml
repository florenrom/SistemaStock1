@model NuevoSistemaNat.Models.ViewModels.Usuario.ResetearPasswordViewModel

@{
    ViewData["Title"] = "Restablecer contraseña";
}

<div class="sf-crud">

    <h1>Restablecer contraseña</h1>

    <p class="sf-crud-description">
        Establecé una nueva contraseña para la cuenta seleccionada.
    </p>

    <div class="sf-crud-card">

        <h5 class="sf-crud-card-title">
            <i class="bi bi-shield-lock me-2"></i>
            Seguridad de la cuenta
        </h5>

        <form asp-controller="Usuario"
              asp-action="ResetearPassword"
              method="post">

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="PasswordNueva" class="form-label">
                    Nueva contraseña
                </label>

                <input asp-for="PasswordNueva"
                       type="password"
                       class="form-control"
                       autocomplete="new-password"
                       placeholder="Ingresá la nueva contraseña" />

                <span asp-validation-for="PasswordNueva"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmarPassword" class="form-label">
                    Confirmar nueva contraseña
                </label>

                <input asp-for="ConfirmarPassword"
                       type="password"
                       class="form-control"
                       autocomplete="new-password"
                       placeholder="Volvé a ingresar la contraseña" />

                <span asp-validation-for="ConfirmarPassword"
                      class="text-danger"></span>
            </div>

            <div class="sf-crud-actions mt-3">

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-shield-check me-1"></i>
                    Restablecer contraseña
                </button>

                <a asp-controller="Usuario"
                   asp-action="Index"
                   class="btn btn-link text-decoration-none">
                    Cancelar
                </a>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}