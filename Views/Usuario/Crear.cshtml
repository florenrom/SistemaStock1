@model NuevoSistemaNat.Models.ViewModels.Usuario.CrearViewModel

@{
    ViewData["Title"] = "Crear usuario";
}

<div class="sf-crud">

    <h1>Crear usuario</h1>

    <p class="sf-crud-description">
        Registrá una nueva cuenta y asignale un rol dentro del sistema.
    </p>

    <div class="sf-crud-card">

        <h5 class="sf-crud-card-title">
            <i class="bi bi-person-plus me-2"></i>
            Información de la cuenta
        </h5>

        <form asp-controller="Usuario"
              asp-action="Crear"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre"
                           class="form-control"
                           placeholder="Nombre del usuario" />
                    <span asp-validation-for="Nombre"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Correo electrónico" />
                    <span asp-validation-for="Email"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password"
                           type="password"
                           class="form-control"
                           placeholder="Ingresá una contraseña" />
                    <span asp-validation-for="Password"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Rol" class="form-label"></label>
                    <select asp-for="Rol"
                            asp-items="ViewBag.Roles"
                            class="form-select">
                        <option value="">Seleccione un rol</option>
                    </select>
                    <span asp-validation-for="Rol"
                          class="text-danger"></span>
                </div>

            </div>

            <div class="sf-crud-actions mt-3">

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-person-check me-1"></i>
                    Crear usuario
                </button>

                <a asp-controller="Usuario"
                   asp-action="Index"
                   class="btn btn-link text-decoration-none">
                    Cancelar
                </a>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}