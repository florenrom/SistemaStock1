@model NuevoSistemaNat.Models.ViewModels.Usuario.EditarViewModel

@{
    ViewData["Title"] = "Editar usuario";
}

<div class="sf-crud">

    <h1>Editar usuario</h1>

    <p class="sf-crud-description">
        Modificá los datos, el rol y el estado de la cuenta.
    </p>

    <div class="sf-crud-card">

        <h5 class="sf-crud-card-title">
            <i class="bi bi-person-gear me-2"></i>
            Información del usuario
        </h5>

        <form asp-controller="Usuario"
              asp-action="Editar"
              method="post">

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre"
                           class="form-control"
                           placeholder="Nombre del usuario" />
                    <span asp-validation-for="Nombre"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Correo electrónico" />
                    <span asp-validation-for="Email"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Rol" class="form-label"></label>
                    <select asp-for="Rol"
                            asp-items="ViewBag.Roles"
                            class="form-select">
                        <option value="">Seleccione un rol</option>
                    </select>
                    <span asp-validation-for="Rol"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label d-block">Estado de la cuenta</label>

                    <div class="form-check form-switch">
                        <input asp-for="Activo"
                               class="form-check-input"
                               role="switch" />
                        <label asp-for="Activo"
                               class="form-check-label">
                            Usuario activo
                        </label>
                    </div>
                </div>

            </div>

            <div class="sf-crud-actions mt-3">

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save me-1"></i>
                    Guardar cambios
                </button>

                <a asp-controller="Usuario"
                   asp-action="Index"
                   class="btn btn-link text-decoration-none">
                    Cancelar
                </a>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}