@model NuevoSistemaNat.Models.ViewModels.CategoriaViewModel

@{
    ViewData["Title"] = "Eliminar categoría";
}

<h1>Eliminar categoría</h1>

<h3>¿Estás seguro de que deseas eliminar esta categoría?</h3>

<div>
    <h4>Datos de la categoría</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CaNombre)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CaNombre)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CADescripcion)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CADescripcion)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Activo)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Activo)
        </dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <input type="submit" value="Eliminar" class="btn btn-danger" />

        <a asp-action="Index" class="btn btn-secondary">
            Volver a la lista
        </a>
    </form>
</div>
