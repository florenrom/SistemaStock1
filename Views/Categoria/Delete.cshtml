@model NuevoSistemaNat.Models.ViewModels.CategoriaViewModel

@{
    ViewData["Title"] = "Eliminar categoría";
}

<div class="sf-crud">

    <h1>Eliminar categoría</h1>

    <p class="sf-crud-description">
        Revisá los datos antes de confirmar la eliminación.
    </p>

    <div class="sf-crud-card">

        <div class="sf-crud-warning mb-4">
            <i class="bi bi-exclamation-triangle me-2"></i>
            ¿Estás seguro de que deseas eliminar esta categoría?
        </div>

        <h5 class="sf-crud-card-title">Información de la categoría</h5>

        <dl class="row sf-crud-details">

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.CaNombre)
            </dt>

            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.CaNombre)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.CADescripcion)
            </dt>

            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.CADescripcion)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Activo)
            </dt>

            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Activo)
            </dd>

        </dl>

        <div class="sf-crud-actions">

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash me-1"></i>
                    Eliminar categoría
                </button>
            </form>

            <a asp-action="Index" class="btn btn-link text-decoration-none">
                Cancelar
            </a>

        </div>

    </div>
</div>