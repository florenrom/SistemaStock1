@model NuevoSistemaNat.Models.ViewModels.CategoriaViewModel

@{
    ViewData["Title"] = "Crear categoría";
}

<div class="sf-crud">

    <h1>Crear categoría</h1>

    <p class="sf-crud-description">
        Completá los datos para registrar una nueva categoría.
    </p>

    <div class="sf-crud-card">

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="CaNombre" class="form-label"></label>
                <input asp-for="CaNombre" class="form-control" />
                <span asp-validation-for="CaNombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CADescripcion" class="form-label"></label>
                <input asp-for="CADescripcion" class="form-control" />
                <span asp-validation-for="CADescripcion" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="Activo" class="form-check-input" />
                <label asp-for="Activo" class="form-check-label"></label>
                <span asp-validation-for="Activo" class="text-danger"></span>
            </div>

            <div class="sf-crud-actions">

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle me-1"></i>
                    Crear categoría
                </button>

                <a asp-action="Index" class="btn btn-link text-decoration-none">
                    Volver a la lista
                </a>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}




