@model List<NuevoSistemaNat.Models.ViewModels.Stock.StockConsultaViewModel>

@{
    ViewData["Title"] = "Consulta de stock";
}

<h1>Consulta de stock</h1>
<p class="text-muted">Consulta las existencias de productos y su distribución por depósito.</p>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Código</th>
                <th>Producto</th>
                <th>Categoría</th>
                <th>Stock total</th>
                <th>Stock mínimo</th>
                <th>Depósitos</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var producto in Model)
                {
                    <tr>
                        <td>@(producto.Codigo ?? "-")</td>
                        <td>@producto.Producto</td>
                        <td>@producto.Categoria</td>
                        <td>@producto.StockTotal</td>
                        <td>@producto.StockMinimo</td>
                        <td>
                            @if (producto.Depositos.Any())
                            {
                                @foreach (var deposito in producto.Depositos)
                                {
                                    <div>
                                        <strong>@deposito.Deposito:</strong>
                                        @deposito.Cantidad
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Sin existencias</span>
                            }
                        </td>
                        <td>
                            @if (producto.StockTotal <= producto.StockMinimo)
                            {
                                <span class="badge bg-danger">Stock bajo</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Disponible</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center">
                        No hay productos registrados.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>