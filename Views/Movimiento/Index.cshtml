@using NuevoSistemaNat.Models.Enum
@model IEnumerable<NuevoSistemaNat.Models.ViewModels.MovimientoViewModel>

@{
    ViewData["Title"] = "Movimientos";
}

<div class="sf-crud">

    <h1>Movimientos de stock</h1>

    <p class="sf-crud-description">
        Consultá el historial de movimientos y registrá ingresos, egresos o transferencias entre depósitos.
    </p>

    @if (TempData["OK"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["OK"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex flex-wrap gap-2 mb-3">

        <a asp-action="Entrada" class="btn btn-primary">
            <i class="bi bi-box-arrow-in-down me-1"></i>
            Nueva entrada
        </a>

        <a asp-action="Salida" class="btn btn-danger">
            <i class="bi bi-box-arrow-up me-1"></i>
            Nueva salida
        </a>

        <a asp-action="Transferencia" class="btn btn-warning">
            <i class="bi bi-arrow-left-right me-1"></i>
            Nueva transferencia
        </a>

    </div>

    <div class="sf-crud-card mb-4">

        <h5 class="sf-crud-card-title">
            <i class="bi bi-funnel me-2"></i>
            Filtrar movimientos
        </h5>

        <form method="get">

            <div class="row align-items-end">

                <div class="col-md-5 mb-3">
                    <label class="form-label">Producto</label>

                    <select name="idProducto"
                            asp-items="ViewBag.Productos"
                            class="form-select">
                        <option value="">Todos los productos</option>
                    </select>
                </div>

                <div class="col-md-5 mb-3">
                    <label class="form-label">Tipo de movimiento</label>

                    <select name="tipo" class="form-select">
                        <option value="">Todos los movimientos</option>

                        @foreach (var tipo in Enum.GetValues(typeof(TipoMovimiento)))
                        {
                            <option value="@tipo">@tipo</option>
                        }
                    </select>
                </div>

                <div class="col-md-2 mb-3">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-1"></i>
                        Buscar
                    </button>
                </div>

            </div>

        </form>
    </div>

    <div class="sf-crud-card">

        <h5 class="sf-crud-card-title">
            <i class="bi bi-clock-history me-2"></i>
            Historial de movimientos
        </h5>

        @if (Model.Count() == 200)
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                Se muestran los últimos 200 movimientos. Utilizá los filtros para acotar la búsqueda.
            </div>
        }

        <div class="table-responsive">

            <table id="tablaMovimientos"
                   class="table table-striped table-bordered align-middle sf-table">

                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th>Producto</th>
                        <th>Depósito origen</th>
                        <th>Depósito destino</th>
                        <th>Cantidad</th>
                        <th>Observaciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @item.Fecha.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @{
                                    var (badgeClass, texto) = item.Tipo switch
                                    {
                                        TipoMovimiento.TransferenciaSalida => ("bg-warning text-dark", "Transf. salida"),
                                        TipoMovimiento.TransferenciaEntrada => ("bg-success", "Transf. entrada"),
                                        TipoMovimiento.Entrada => ("bg-primary", "Ingreso"),
                                        TipoMovimiento.Salida => ("bg-danger", "Egreso"),
                                        _ => ("bg-secondary", item.Tipo.ToString())
                                    };
                                }

                                <span class="badge @badgeClass">@texto</span>
                            </td>

                            <td>@item.ProductoNombre</td>

                            <td>@item.DepositoOrigenNombre</td>

                            <td>@item.DepositoDestinoNombre</td>

                            <td>@item.Cantidad</td>

                            <td>@item.Observaciones</td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-4">
                <i class="bi bi-inbox fs-2 text-muted"></i>
                <p class="text-muted mt-2 mb-0">
                    No hay movimientos para mostrar.
                </p>
            </div>
        }

    </div>
</div>