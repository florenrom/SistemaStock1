@model NuevoSistemaNat.Models.ViewModels.OperacionStockSalidaViewModel

@{
    ViewData["Title"] = "Registrar salida";
}

<div class="sf-crud">

    <h1>Registrar salida de stock</h1>

    <p class="sf-crud-description">
        Registrá el egreso de productos de un depósito y asociá la operación al cliente correspondiente.
    </p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["Error"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <div class="sf-crud-card">

        <h5 class="sf-crud-card-title">
            <i class="bi bi-box-arrow-up me-2"></i>
            Datos de la salida
        </h5>

        <form asp-action="Salida" method="post">

            <div asp-validation-summary="All"
                 class="text-danger mb-3"></div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label asp-for="idProducto" class="form-label"></label>

                    <select asp-for="idProducto"
                            class="form-select"
                            asp-items="Model.Productos">
                        <option value="">-- Seleccione un producto --</option>
                    </select>

                    <span asp-validation-for="idProducto"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="idDepositoOrigen" class="form-label"></label>

                    <select asp-for="idDepositoOrigen"
                            class="form-select"
                            asp-items="Model.Depositos">
                        <option value="">-- Seleccione un depósito --</option>
                    </select>

                    <span asp-validation-for="idDepositoOrigen"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Cantidad" class="form-label"></label>

                    <input asp-for="Cantidad"
                           class="form-control"
                           placeholder="Ingresá la cantidad" />

                    <span asp-validation-for="Cantidad"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="idCliente" class="form-label"></label>

                    <select asp-for="idCliente"
                            class="form-select"
                            asp-items="Model.Clientes">
                        <option value="">-- Seleccione un cliente --</option>
                    </select>

                    <span asp-validation-for="idCliente"
                          class="text-danger"></span>
                </div>

                <div class="col-12 mb-3">
                    <label asp-for="Observaciones" class="form-label"></label>

                    <textarea asp-for="Observaciones"
                              class="form-control"
                              rows="3"
                              placeholder="Observaciones adicionales (opcional)"></textarea>

                    <span asp-validation-for="Observaciones"
                          class="text-danger"></span>
                </div>

            </div>

            <div class="sf-crud-actions mt-3">

                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-check-circle me-1"></i>
                    Registrar salida
                </button>

                <a asp-action="Index"
                   class="btn btn-link text-decoration-none">
                    Cancelar
                </a>

            </div>

        </form>

    </div>
</div>