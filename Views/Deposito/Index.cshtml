@model IEnumerable<NuevoSistemaNat.Models.ViewModels.DepositoViewModel>

@{
    ViewData["Title"] = "Depósitos";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Administración de depósitos</h2>

        <a asp-action="Create" class="btn btn-primary">
            Nuevo depósito
        </a>
    </div>

    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success">
            @TempData["Ok"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <form asp-action="Index" method="get" class="mb-3">
        <div class="input-group">
            <input type="text"
                   name="buscar"
                   class="form-control"
                   placeholder="Buscar por nombre o ubicación..."
                   value="@Context.Request.Query["buscar"]" />

            <button type="submit" class="btn btn-secondary">
                Buscar
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Limpiar
            </a>
        </div>
    </form>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle sf-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Ubicación</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var deposito in Model)
                    {
                        <tr>
                            <td>@deposito.Nombre</td>
                            <td>@(deposito.Ubicacion ?? "Sin ubicación")</td>
                            <td>
                                @if (deposito.Activo)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@deposito.id"
                                   class="btn btn-info btn-sm">
                                    Ver
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@deposito.id"
                                   class="btn btn-warning btn-sm">
                                    Editar
                                </a>

                                @if (deposito.Activo)
                                {
                                    <a asp-action="Delete"
                                       asp-route-id="@deposito.id"
                                       class="btn btn-danger btn-sm">
                                        Desactivar
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    else
    {
        <div class="alert alert-info">
            No se encontraron depósitos.
        </div>
    }

</div>