@model IEnumerable<NuevoSistemaNat.Models.ViewModels.DepositoViewModel>

@{
    ViewData["Title"] = "Depósitos";
}

<div class="sf-crud">

    <h1>Administración de depósitos</h1>

    <p class="sf-crud-description">
        Consultá y administrá los depósitos registrados en el sistema.
    </p>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h5 class="mb-1">Depósitos registrados</h5>
            <span class="text-muted">Listado general de depósitos</span>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Nuevo depósito
        </a>
    </div>

    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Ok"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="sf-crud-card">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <h5 class="sf-crud-card-title mb-0">
                <i class="bi bi-building me-2"></i>
                Listado de depósitos
            </h5>

            <span class="text-muted small">
                Total: @Model.Count() depósitos
            </span>
        </div>

        <form asp-action="Index" method="get" class="mb-4">
            <div class="input-group">
                <span class="input-group-text">
                    <i class="bi bi-search"></i>
                </span>

                <input type="text"
                       name="buscar"
                       class="form-control"
                       placeholder="Buscar por nombre o ubicación..."
                       value="@Context.Request.Query["buscar"]" />

                <button type="submit" class="btn btn-primary">
                    Buscar
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Limpiar
                </a>
            </div>
        </form>

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle sf-table">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Ubicación</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var deposito in Model)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @deposito.Nombre
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(deposito.Ubicacion)
                                                                ? "Sin ubicación"
                                                                : deposito.Ubicacion)
                        </td>

                                <td>
                            @if (deposito.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </td>

                                <td class="text-center">
                                    <div class="d-flex justify-content-center flex-wrap gap-1">

                                        <a asp-action="Details"
                                           asp-route-id="@deposito.id"
                                           class="btn btn-info btn-sm"
                                           title="Ver detalles">
                                            <i class="bi bi-eye"></i>
                                            Ver
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@deposito.id"
                                           class="btn btn-warning btn-sm"
                                           title="Editar depósito">
                                            <i class="bi bi-pencil"></i>
                                            Editar
                                        </a>

                                        @if (deposito.Activo)
                                        {
                                            <a asp-action="Delete"
                                               asp-route-id="@deposito.id"
                                               class="btn btn-danger btn-sm"
                                               title="Desactivar depósito">
                                                <i class="bi bi-ban"></i>
                                                Desactivar
                                            </a>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info mb-0">
                <i class="bi bi-info-circle me-2"></i>
                No se encontraron depósitos.
            </div>
        }

    </div>

</div>