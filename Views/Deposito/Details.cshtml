@model NuevoSistemaNat.Models.ViewModels.DepositoViewModel

@{
    ViewData["Title"] = "Detalles del depósito";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Detalles del depósito</h2>

        <a asp-action="Index" class="btn btn-secondary">
            Volver
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">Información del depósito</h5>
        </div>

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">Identificador</dt>
                <dd class="col-sm-9">@Model.id</dd>

                <dt class="col-sm-3">Nombre</dt>
                <dd class="col-sm-9">@Model.Nombre</dd>

                <dt class="col-sm-3">Ubicación</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.Ubicacion)
                                        ? "Sin ubicación"
                                        : Model.Ubicacion)
                </dd>

                <dt class="col-sm-3">Estado</dt>
                <dd class="col-sm-9">
                    @if (Model.Activo)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </dd>

            </dl>

        </div>

        <div class="card-footer">
            <a asp-action="Edit"
               asp-route-id="@Model.id"
               class="btn btn-warning">
                Editar
            </a>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Volver al listado
            </a>
        </div>
    </div>

</div>