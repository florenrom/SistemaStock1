@model NuevoSistemaNat.Models.ViewModels.DepositoViewModel

@{
    ViewData["Title"] = "Desactivar depósito";
}

<div class="container mt-4">

    <h2>Desactivar depósito</h2>

    <div class="alert alert-warning mt-3">
        <i class="bi bi-exclamation-triangle me-2"></i>
        ¿Estás seguro de que deseas desactivar este depósito?
        El registro no se eliminará de la base de datos.
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">Datos del depósito</h5>
        </div>

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">Identificador</dt>
                <dd class="col-sm-9">@Model.id</dd>

                <dt class="col-sm-3">Nombre</dt>
                <dd class="col-sm-9">@Model.Nombre</dd>

                <dt class="col-sm-3">Ubicación</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.Ubicacion)
                                        ? "Sin ubicación"
                                        : Model.Ubicacion)
                </dd>

                <dt class="col-sm-3">Estado actual</dt>
                <dd class="col-sm-9">
                    @if (Model.Activo)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </dd>

            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" name="id" value="@Model.id" />

                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-ban me-1"></i>
                    Confirmar desactivación
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancelar
                </a>
            </form>

        </div>
    </div>

</div>