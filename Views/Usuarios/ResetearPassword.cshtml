@model NuevoSistemaNat.Models.ViewModels.Usuario.ResetearPasswordViewModel

@{
    ViewData["Title"] = "Restablecer contraseña";
}

<h2>Restablecer contraseña</h2>

<form asp-controller="Usuario"
      asp-action="ResetearPassword"
      method="post">

    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="PasswordNueva" class="form-label">
            Nueva contraseña
        </label>
        <input asp-for="PasswordNueva" class="form-control" />
        <span asp-validation-for="PasswordNueva" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ConfirmarPassword" class="form-label">
            Confirmar nueva contraseña
        </label>
        <input asp-for="ConfirmarPassword" class="form-control" />
        <span asp-validation-for="ConfirmarPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Restablecer contraseña
    </button>

    <a asp-controller="Usuario"
       asp-action="Index"
       class="btn btn-secondary">
        Volver
    </a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}