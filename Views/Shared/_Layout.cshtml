@{
    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();
    var accionActual = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="es">
<head>

    @* <li class="nav-header">GESTIÓN</li> *@

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StockFlow </title>

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.2/font/bootstrap-icons.min.css" />

    <!-- DataTables -->
    <link rel="stylesheet"
          href="https://cdn.datatables.net/2.3.2/css/dataTables.bootstrap5.min.css" />

    <!-- OverlayScrollbars -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.17.0/styles/overlayscrollbars.min.css" />

    <!-- AdminLTE 4 -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/admin-lte@4.10.2/dist/css/adminlte.min.css" />

    <!-- Estilos propios del proyecto -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NuevoSistemaNat.styles.css" asp-append-version="true" />
</head>

<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">

    <div class="app-wrapper">

        <!-- BARRA SUPERIOR -->
        <nav class="app-header sf-topbar navbar navbar-expand shadow-sm">
            <div class="container-fluid">

                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link"
                           data-lte-toggle="sidebar"
                           href="#"
                           role="button">
                            <i class="bi bi-list"></i>
                        </a>
                    </li>
                </ul>

                <ul class="navbar-nav ms-auto">

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <span class="nav-link">
                                <i class="bi bi-person-circle me-1"></i>
                                @User.Identity.Name
                            </span>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Cuenta"
                               asp-action="CambiarPassword"
                               class="nav-link">
                                <i class="bi bi-key me-1"></i>
                                Cambiar contraseña
                            </a>
                        </li>

                        <li class="nav-item">
                            <form asp-controller="Cuenta"
                                  asp-action="Logout"
                                  method="post">
                                <button type="submit" class="nav-link">
                                    <i class="bi bi-box-arrow-right me-1"></i>
                                    Cerrar sesión
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a asp-controller="Cuenta"
                               asp-action="Login"
                               class="nav-link">
                                <i class="bi bi-box-arrow-in-right me-1"></i>
                                Iniciar sesión
                            </a>
                        </li>
                    }

                </ul>

            </div>
        </nav>

        <!-- MENÚ LATERAL -->
        <aside class="app-sidebar sf-sidebar shadow"
               data-bs-theme="dark">

            <!-- LOGO / NOMBRE -->
            <div class="sidebar-brand">
                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="brand-link text-decoration-none">
                    <i class="bi bi-box-seam me-2"></i>
                    <span class="brand-text fw-light"> StockFlow </span>
                </a>
            </div>

            <!-- OPCIONES DEL MENÚ -->
            <div class="sidebar-wrapper">

                <nav class="mt-2">
                    <ul class="nav sidebar-menu flex-column"
                        data-lte-toggle="treeview"
                        role="menu">

                        <li class="nav-item">
                            <a asp-controller="Dashboard"
                               asp-action="Index"
                               class="nav-link @(controladorActual == "Dashboard" ? "active" : "")">
                                <i class="nav-icon bi bi-speedometer2"></i>
                                <p>Panel de control</p>
                            </a>
                        </li>

                        <li class="nav-header">GESTIÓN</li>

                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item">
                                <a asp-controller="Usuario"
                                   asp-action="Index"
                                   class="nav-link @(controladorActual == "Usuario" ? "active" : "")">
                                    <i class="nav-icon bi bi-people"></i>
                                    <p>Administrar usuarios</p>
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Administrador") || User.IsInRole("Encargado"))
                        {
                            <li class="nav-item">
                                <a asp-controller="Categoria"
                                   asp-action="Index"
                                   class="nav-link @(controladorActual == "Categoria" ? "active" : "")">
                                    <i class="nav-icon bi bi-tags"></i>
                                    <p>Categorías</p>
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Productos"
                                   asp-action="Index"
                                   class="nav-link @(controladorActual == "Productos" ? "active" : "")">
                                    <i class="nav-icon bi bi-box-seam"></i>
                                    <p>Productos</p>
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Administrador") ||User.IsInRole("Encargado") ||User.IsInRole("Operador"))
                        {
                            <li class="nav-item">
                                <a asp-controller="Movimiento"
                                   asp-action="Index"
                                   class="nav-link @(controladorActual == "Movimiento" && accionActual == "Index" ? "active" : "")">
                                    <i class="nav-icon bi bi-arrow-left-right"></i>
                                    <p>Movimientos</p>
                                </a>
                            </li>

                            @if (User.IsInRole("Administrador") || User.IsInRole("Operador"))
                            {
                                <li class="nav-item">
                                    <a asp-controller="Movimiento"
                                       asp-action="Entrada"
                                       class="nav-link @(controladorActual == "Movimiento" && accionActual == "Entrada" ? "active" : "")">
                                        <i class="nav-icon bi bi-box-arrow-in-down"></i>
                                        <p>Registrar entrada</p>
                                    </a>
                                </li>
                            }

                            <li class="nav-item">
                                <a asp-controller="Movimiento"
                                   asp-action="Salida"
                                   class="nav-link @(controladorActual == "Movimiento" && accionActual == "Salida" ? "active" : "")">
                                    <i class="nav-icon bi bi-box-arrow-up"></i>
                                    <p>Registrar salida</p>
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Movimiento"
                                   asp-action="Transferencia"
                                   class="nav-link @(controladorActual == "Movimiento" && accionActual == "Transferencia" ? "active" : "")">
                                    <i class="nav-icon bi bi-arrow-left-right"></i>
                                    <p>Transferencias</p>
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Administrador") || User.IsInRole("Encargado") || User.IsInRole("Consulta"))
                        {
                            <li class="nav-item">
                                <a asp-controller="Reporte"
                                   asp-action="Index"
                                   class="nav-link @(controladorActual == "Reporte" ? "active" : "")">
                                    <i class="nav-icon bi bi-file-earmark-bar-graph"></i>
                                    <p>Reportes</p>
                                </a>
                            </li>
                        }

                    </ul>
                </nav>

            </div>
        </aside>

        <!-- CONTENIDO PRINCIPAL -->
        <main class="app-main">

            <div class="app-content">
                <div class="container-fluid py-3">

                    @RenderBody()

                </div>
            </div>

        </main>

        <!-- PIE DE PÁGINA -->
        <footer class="app-footer">
            <strong>
                StockFlow
            </strong>
            <span class="float-end d-none d-sm-inline">
                Trabajo Integrador Final
            </span>
        </footer>

    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/@@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/js/bootstrap.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.17.0/browser/overlayscrollbars.browser.es6.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/admin-lte@4.10.2/dist/js/adminlte.min.js"></script>

    <!-- DataTables -->
    <script src="https://cdn.datatables.net/2.3.2/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.2/js/dataTables.bootstrap5.min.js"></script>

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
   
</body>
</html>