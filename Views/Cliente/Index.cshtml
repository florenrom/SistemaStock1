@model IEnumerable<NuevoSistemaNat.Models.ViewModels.ClienteViewModel>

@{
    ViewData["Title"] = "Clientes";
}

<div class="sf-crud">

    <h1>Administración de clientes</h1>

    <p class="sf-crud-description">
        Consultá y administrá los clientes registrados.
    </p>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h5 class="mb-1">Clientes registrados</h5>
            <span class="text-muted">Listado general de clientes</span>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus me-1"></i>
            Nuevo cliente
        </a>
    </div>

    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Ok"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"
                    aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"
                    aria-label="Cerrar"></button>
        </div>
    }

    <div class="sf-crud-card">

        <h5 class="sf-crud-card-title mb-3">
            <i class="bi bi-people me-2"></i>
            Listado de clientes
        </h5>

        <form asp-action="Index" method="get" class="mb-4">
            <div class="input-group">
                <input type="text"
                       name="buscar"
                       class="form-control"
                       placeholder="Buscar por nombre, documento, teléfono o email..."
                       value="@Context.Request.Query["buscar"]" />

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search me-1"></i>
                    Buscar
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i>
                    Limpiar
                </a>
            </div>
        </form>

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle sf-table">

                    <thead>
                        <tr>
                            <th>Nombre / Razón Social</th>
                            <th>Documento</th>
                            <th>Dirección</th>
                            <th>Teléfono</th>
                            <th>Email</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var cliente in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@cliente.Nombre</td>
                                <td>@(cliente.Documento ?? "Sin documento")</td>
                                <td>@(cliente.Direccion ?? "Sin dirección")</td>
                                <td>@(cliente.Telefono ?? "Sin teléfono")</td>
                                <td>@(cliente.Email ?? "Sin email")</td>

                                <td>
                                    @if (cliente.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex justify-content-center gap-1 flex-wrap">

                                        <a asp-action="Details"
                                           asp-route-id="@cliente.id"
                                           class="btn btn-info btn-sm"
                                           title="Ver detalles">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@cliente.id"
                                           class="btn btn-warning btn-sm"
                                           title="Editar cliente">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        @if (cliente.Activo)
                                        {
                                            <a asp-action="Delete"
                                               asp-route-id="@cliente.id"
                                               class="btn btn-danger btn-sm"
                                               title="Desactivar cliente">
                                                <i class="bi bi-person-x"></i>
                                            </a>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info mb-0">
                <i class="bi bi-info-circle me-2"></i>
                No se encontraron clientes.
            </div>
        }

    </div>

</div>