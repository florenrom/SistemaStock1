@model NuevoSistemaNat.Models.ViewModels.ClienteViewModel

@{
    ViewData["Title"] = "Detalle del cliente";
}

<div class="sf-crud">

    <h1>Detalle del cliente</h1>

    <p class="sf-crud-description">
        Consultá la información registrada del cliente.
    </p>

    <div class="sf-crud-card">

        <h5 class="sf-crud-card-title">Información del cliente</h5>

        <dl class="row sf-crud-details">

            <dt class="col-sm-4">Nombre</dt>
            <dd class="col-sm-8">@Model.Nombre</dd>

            <dt class="col-sm-4">Documento</dt>
            <dd class="col-sm-8">@Model.Documento</dd>

            <dt class="col-sm-4">Dirección</dt>
            <dd class="col-sm-8">@Model.Direccion</dd>

            <dt class="col-sm-4">Teléfono</dt>
            <dd class="col-sm-8">@Model.Telefono</dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.Email</dd>

            <dt class="col-sm-4">Estado</dt>
            <dd class="col-sm-8">
                @if (Model.Activo)
                {
                    <span class="badge bg-success">Activo</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactivo</span>
                }
            </dd>

        </dl>

        <div class="sf-crud-actions">

            <a asp-action="Edit"
               asp-route-id="@Model.id"
               class="btn btn-primary">
                <i class="bi bi-pencil-square me-1"></i>
                Editar
            </a>

            <a asp-action="Index"
               class="btn btn-link text-decoration-none">
                Volver
            </a>

        </div>

    </div>
</div>