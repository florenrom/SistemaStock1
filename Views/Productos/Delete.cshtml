@model NuevoSistemaNat.Models.ViewModels.ProductoViewModel

@{
    ViewData["Title"] = "Eliminar producto";
}

<div class="sf-crud">

    <h1>Eliminar producto</h1>

    <p class="sf-crud-description">
        Revisá la información antes de confirmar la eliminación.
    </p>

    <div class="sf-crud-card">

        <h5 class="sf-crud-card-title">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Datos del producto
        </h5>

        <div class="sf-crud-warning mb-4">
            <i class="bi bi-exclamation-circle me-2"></i>
            ¿Estás seguro de que deseas eliminar este producto?
            Esta acción puede afectar los registros relacionados con el inventario.
        </div>

        <dl class="row sf-crud-details">

            <dt class="col-md-4">@Html.DisplayNameFor(model => model.Codigo)</dt>
            <dd class="col-md-8">@Html.DisplayFor(model => model.Codigo)</dd>

            <dt class="col-md-4">@Html.DisplayNameFor(model => model.Nombre)</dt>
            <dd class="col-md-8">@Html.DisplayFor(model => model.Nombre)</dd>

            <dt class="col-md-4">@Html.DisplayNameFor(model => model.Descripcion)</dt>
            <dd class="col-md-8">@Html.DisplayFor(model => model.Descripcion)</dd>

            <dt class="col-md-4">@Html.DisplayNameFor(model => model.idCategoria)</dt>
            <dd class="col-md-8">@Html.DisplayFor(model => model.CategoriaNombre)</dd>

            <dt class="col-md-4">@Html.DisplayNameFor(model => model.CantidadStock)</dt>
            <dd class="col-md-8">@Html.DisplayFor(model => model.CantidadStock)</dd>

            <dt class="col-md-4">@Html.DisplayNameFor(model => model.UnidadDeMedida)</dt>
            <dd class="col-md-8">@Html.DisplayFor(model => model.UnidadDeMedida)</dd>

            <dt class="col-md-4">@Html.DisplayNameFor(model => model.PrecioCosto)</dt>
            <dd class="col-md-8">@Html.DisplayFor(model => model.PrecioCosto)</dd>

            <dt class="col-md-4">@Html.DisplayNameFor(model => model.PrecioVenta)</dt>
            <dd class="col-md-8">@Html.DisplayFor(model => model.PrecioVenta)</dd>

            <dt class="col-md-4">@Html.DisplayNameFor(model => model.StockMinimo)</dt>
            <dd class="col-md-8">@Html.DisplayFor(model => model.StockMinimo)</dd>

        </dl>

        <form asp-action="Delete" method="post">

            <input type="hidden" asp-for="id" />

            <div class="sf-crud-actions mt-3">

                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash me-1"></i>
                    Confirmar eliminación
                </button>

                <a asp-action="Index"
                   class="btn btn-link text-decoration-none">
                    Cancelar
                </a>

            </div>

        </form>

    </div>
</div>