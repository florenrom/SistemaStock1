@model IEnumerable<NuevoSistemaNat.Models.ViewModels.ProductoViewModel>

@{
    ViewData["Title"] = "Stock de productos";
}

<div class="sf-crud">

    <h1>Stock de productos</h1>

    <p class="sf-crud-description">
        Consultá, buscá y administrá los productos registrados en el inventario.
    </p>

    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Ok"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"
                    aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"
                    aria-label="Cerrar"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h5 class="mb-1">Productos registrados</h5>
            <span class="text-muted">Listado general del inventario</span>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Nuevo producto
        </a>

    </div>

    <div class="sf-crud-card mb-4">

        <h5 class="sf-crud-card-title">
            <i class="bi bi-funnel me-2"></i>
            Buscar productos
        </h5>

        <form method="get" class="row g-3 align-items-end">

            <div class="col-md-5">
                <label class="form-label">Nombre o código</label>
                <input type="text"
                       name="buscar"
                       class="form-control"
                       placeholder="Buscar producto..." />
            </div>

            <div class="col-md-5">
                <label class="form-label">Categoría</label>
                <select name="buscarCategoria"
                        class="form-select"
                        asp-items="ViewBag.Categorias">
                    <option value="">Todas las categorías</option>
                </select>
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search me-1"></i>
                    Buscar
                </button>
            </div>

        </form>

    </div>

    <div class="sf-crud-card">

        <div class="table-responsive">

            <table id="tablaProductos"
                   class="table table-striped table-bordered align-middle sf-table">

                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Cantidad en stock</th>
                        <th>Precio de costo</th>
                        <th>Precio de venta</th>
                        <th>Categoría</th>
                        <th>Unidad de medida</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(model => item.Codigo)</td>
                            <td>@Html.DisplayFor(model => item.Nombre)</td>
                            <td>@Html.DisplayFor(model => item.Descripcion)</td>
                            <td>@Html.DisplayFor(model => item.CantidadStock)</td>
                            <td>@Html.DisplayFor(model => item.PrecioCosto)</td>
                            <td>@Html.DisplayFor(model => item.PrecioVenta)</td>
                            <td>@Html.DisplayFor(model => item.CategoriaNombre)</td>
                            <td>@Html.DisplayFor(model => item.UnidadDeMedida)</td>

                            <td>
                                <div class="d-flex gap-1 flex-wrap">

                                    <a asp-action="Details"
                                       asp-route-id="@item.id"
                                       class="btn btn-sm btn-info"
                                       title="Ver detalles">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.id"
                                       class="btn btn-sm btn-warning"
                                       title="Editar producto">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@item.id"
                                          method="post"
                                          class="form-eliminar d-inline"
                                          data-nombre="@item.Nombre">

                                        <button type="submit"
                                                class="btn btn-sm btn-danger"
                                                title="Eliminar producto">
                                            <i class="bi bi-trash"></i>
                                        </button>

                                    </form>

                                </div>
                            </td>
                        </tr>
                }
                </tbody>

            </table>

        </div>

    </div>

</div>