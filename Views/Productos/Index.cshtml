@model IEnumerable<NuevoSistemaNat.Models.ViewModels.ProductoViewModel>

@{
    ViewData["Title"] = "Listado de Stock";
}

<h1>Stock de Productos</h1>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["Ok"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo Producto</a>
</p>

<form method="get" class="row mb-3">
    <div class="col-auto">
        <input type="text" name="buscar" class="form-control"
               placeholder="Buscar..." />
    </div>

    <div class="col-auto">
        <select name="buscarCategoria" class="form-select"
                asp-items="ViewBag.Categorias">
            <option value="">Todas las categorías</option>
        </select>
    </div>

    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Buscar</button>
    </div>
</form>

<table id="tablaProductos" class="table table-striped table-bordered align-middle sf-table">
    <thead>
        <tr>
            <th>Código</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Cantidad en Stock</th>
            <th>Precio de Costo</th>
            <th>Precio de Venta</th>
            <th>Categoría</th>
            <th>Unidad de Medida</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(model => item.Codigo)</td>
                <td>@Html.DisplayFor(model => item.Nombre)</td>
                <td>@Html.DisplayFor(model => item.Descripcion)</td>
                <td>@Html.DisplayFor(model => item.CantidadStock)</td>
                <td>@Html.DisplayFor(model => item.PrecioCosto)</td>
                <td>@Html.DisplayFor(model => item.PrecioVenta)</td>
                <td>@Html.DisplayFor(model => item.CategoriaNombre)</td>
                <td>@Html.DisplayFor(model => item.UnidadDeMedida)</td>

                <td>
                    <a asp-action="Details" asp-route-id="@item.id"
                       class="btn btn-sm btn-info">Ver</a>

                    <a asp-action="Edit" asp-route-id="@item.id"
                       class="btn btn-sm btn-warning">Editar</a>

                    <form asp-action="Delete"
                          asp-route-id="@item.id"
                          method="post"
                          class="form-eliminar d-inline"
                          data-nombre="@item.Nombre">

                        <button type="submit" class="btn btn-sm btn-danger">
                            Eliminar
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
